# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO PHÂN HỆ RAG (P8) - HỖ TRỢ ĐÁI THÁO ĐƯỜNG TYPE 2
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép file này thành file `.env` (lệnh: copy .env.example .env)
# 2. Điền API Key của Google Gemini vào mục GEMINI_API_KEY bên dưới
# 3. File `.env` đã được cấu hình trong .gitignore, tuyệt đối không commit lên Git!
# ==============================================================================

# Google Gemini API Key (Lấy tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Mô hình Gemini sử dụng (Mặc định: gemini-1.5-flash hoặc gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Nhiệt độ sinh văn bản (Temperature): 0.0 - 0.2 khuyến nghị cho y khoa để giảm tối đa ảo giác
LLM_TEMPERATURE=0.1

# Giới hạn số token đầu ra
LLM_MAX_OUTPUT_TOKENS=1024

# Chế độ chạy: nếu chưa có API Key hoặc muốn chạy mock trong unit test, đặt USE_MOCK_LLM=true
# Nếu USE_MOCK_LLM=false và GEMINI_API_KEY có giá trị, hệ thống sẽ gọi trực tiếp Gemini API
USE_MOCK_LLM=false

